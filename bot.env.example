# Copie este arquivo para "bot.env" e preencha os valores.
# NUNCA suba o bot.env para o GitHub.

DISCORD_TOKEN=cole_o_token_aqui

# IDs dos canais armadilha, separados por vírgula, sem espaços
HONEYPOT_CHANNEL_IDS=123456789012345678

# IDs de quem nunca deve ser banido (o dono do servidor já é protegido sozinho)
PROTECTED_USER_IDS=123456789012345678

# true = só registra no terminal, não bane ninguém | false = bane de verdade
DRY_RUN=true
